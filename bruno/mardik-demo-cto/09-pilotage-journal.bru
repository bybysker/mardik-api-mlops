meta {
  name: 9. Pilotage — journal (historique des décisions)
  type: http
  seq: 9
}

get {
  url: http://localhost:8002/pilotage/journal
  body: none
  auth: none
}

docs {
  Chaque décision de la démo (canary, promotion ou rollback) doit
  apparaître ici, avec l'horodatage, le signal, le déclencheur (auto/
  humain) et les versions avant/après — « qui, quand, pourquoi ». Filtrer
  par signal avec ?signal=canary si besoin.
}
